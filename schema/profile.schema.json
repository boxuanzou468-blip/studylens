{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudyLens learner profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_folder", "goals", "level"],
  "properties": {
    "video_folder": {"type": "string", "pattern": "\\S", "description": "用户提供的本地影片文件夹路径"},
    "goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "level": {"enum": ["beginner", "basic", "advanced"], "description": "新手 / 有基础 / 进阶"},
    "time_budget_min": {"type": "number", "exclusiveMinimum": 0},
    "language": {"type": "string", "pattern": "\\S", "description": "如 zh-CN、zh-TW、en"}
  }
}
