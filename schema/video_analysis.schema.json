{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudyLens single-video analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "title", "summary", "topics", "relevance", "segments"],
  "properties": {
    "video_id": {"type": "string", "pattern": "\\S"},
    "title": {"type": "string", "pattern": "\\S"},
    "summary": {"type": "string", "pattern": "\\S"},
    "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "relevance": {"type": "integer", "minimum": 0, "maximum": 100},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "title", "summary", "keypoints", "label", "reason"],
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "title": {"type": "string", "pattern": "\\S"},
          "summary": {"type": "string", "pattern": "\\S", "description": "2～3 句摘要；语义及句数由 AI 人工审查"},
          "keypoints": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}},
          "label": {"enum": ["must", "normal", "speed", "skip"]},
          "reason": {"type": "string", "pattern": "\\S"},
          "speed": {"type": "number", "minimum": 1.25, "maximum": 2.5}
        },
        "allOf": [{
          "if": {"properties": {"label": {"const": "speed"}}, "required": ["label"]},
          "then": {"required": ["speed"]},
          "else": {"not": {"required": ["speed"]}}
        }]
      }
    }
  }
}
